# Copy this file to .env.local and fill in the values.
# On Vercel, add the same keys under Project -> Settings -> Environment Variables.

# Required — create a free key at https://resend.com/api-keys
RESEND_API_KEY=

# Optional — where contact form messages are delivered. Defaults to site.email.
# Without a verified domain in Resend, this MUST be the same address you
# signed up to Resend with, or the email will not be delivered.
CONTACT_TO_EMAIL=

# Optional — who the email appears to be from. Leave empty to use Resend's
# shared test sender. Set it only after verifying your own domain in Resend,
# e.g. "Portfolio <hello@yourdomain.com>".
CONTACT_FROM_EMAIL=
